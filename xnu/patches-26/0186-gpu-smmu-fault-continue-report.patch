@@ -197,6 +201,7 @@ private:
 
 public:
 	void fillClientDiag(struct sweet_diag_gpu_client *out);
+	bool describeIova(uint64_t iova, const char *what, uint32_t seq);
 	bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
 	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
