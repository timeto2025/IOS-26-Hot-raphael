@@ -1583,6 +1588,189 @@ SweetAcceleratorUserClient::fillClientDiag(struct sweet_diag_gpu_client *out)
 	out->faults = fFaults;
 }
 
+/*
+ * ---- the report of a GPU fault (bsd/dev/sweet_gpu.c calls sweet_accel_fault_describe from a thread call) ----
+ */
+
+/* With gAccelClientsLock: if the address is in this client's window, one line on what the client has there. */
+bool
+SweetAcceleratorUserClient::describeIova(uint64_t iova, const char *what, uint32_t seq)
+{
+	if (!fV2 || fWinSize == 0 || fBO == NULL || iova < fWinBase || iova >= fWinBase + fWinSize) {
+		return false;
+	}
+	uint64_t hit = 0, hit_iova = 0, hit_bytes = 0, below = 0, below_bytes = 0, above = 0, mapped_bytes = 0;
+	uint32_t mapped = 0;
+	bool hit_imported = false;
+	IOLockLock(fLock);
+	for (uint32_t i = 0; i < fBOCap; i++) {
+		const SweetV2BO *b = &fBO[i];
+		if (b->md == NULL || b->iova == 0) {
+			continue;
+		}
+		mapped++;
+		mapped_bytes += b->bytes;
+		if (iova >= b->iova && iova < b->iova + b->bytes) {
+			hit = i + 1;
+			hit_iova = b->iova;
+			hit_bytes = b->bytes;
+			hit_imported = b->imported;
+		} else if (b->iova < iova && b->iova >= below) {
+			below = b->iova;
+			below_bytes = b->bytes;
+		} else if (b->iova > iova && (above == 0 || b->iova < above)) {
+			above = b->iova;
+		}
+	}
+	IOLockUnlock(fLock);
+	if (hit != 0) {
+		IOLog("SWEET GPU: fault %u: %s %llx: %s[%d]'s buffer %llu (%llx + %llx, %s)\n", seq, what, iova, fName, fPid, hit,
+		    hit_iova, hit_bytes, hit_imported ? "imported pages" : "pool");
+	} else {
+		IOLog("SWEET GPU: fault %u: %s %llx: in %s[%d]'s window, in none of its %u mapped buffers (%llu MB); the one "
+		    "below is %llx + %llx, the one above starts at %llx\n", seq, what, iova, fName, fPid, mapped, mapped_bytes >> 20,
+		    below, below_bytes, above);
+	}
+	return true;
+}
+
+/* Words of GPU memory (pool memory only), through a write-combined kernel view as BoAlloc's: how many were read. */
+static uint32_t
+sweet_fault_read(uint64_t iova, uint32_t *out, uint32_t ndw)
+{
+	uint32_t got = 0;
+	iova &= ~3ULL;
+	while (got < ndw) {
+		uint64_t va = iova + 4ULL * got, pa = sweet_gpu_iova_pa(va & ~4095ULL);
+		uint32_t n = (uint32_t)((4096 - (va & 4095)) / 4);
+		if (n > ndw - got) {
+			n = ndw - got;
+		}
+		if (pa == 0 || !sweet_gpu_pool_has(pa & ~4095ULL, 4096)) {
+			break;
+		}
+		IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(pa & ~4095ULL, 4096, kIODirectionInOut);
+		IOMemoryMap *km = md != NULL ? md->map(kIOMapWriteCombineCache) : NULL;
+		if (km == NULL) {
+			OSSafeReleaseNULL(md);
+			break;
+		}
+		memcpy(out + got, (const void *)(km->getVirtualAddress() + (va & 4095)), 4ULL * n);
+		km->release();
+		md->release();
+		got += n;
+	}
+	return got;
+}
+
+/* count words from word `first` of an IB, eight a line; the line with word `mark` is pointed at */
+static void
+sweet_fault_dump(uint32_t seq, const char *what, const uint32_t *dw, uint32_t first, uint32_t count, uint32_t mark)
+{
+	for (uint32_t i = 0; i < count; i += 8) {
+		char line[8 * 9 + 1];
+		size_t l = 0;
+		line[0] = 0;
+		for (uint32_t k = i; k < count && k < i + 8; k++) {
+			l += (size_t)snprintf(line + l, sizeof(line) - l, " %08x", dw[k]);
+		}
+		IOLog("SWEET GPU: fault %u: %s word %5u:%s%s\n", seq, what, first + i, line,
+		    mark >= first + i && mark < first + i + 8 ? "  <- CP" : "");
+	}
+}
+
+/* the 64-bit values in an IB that are GPU addresses up to 64 MB below the faulting one (at most 12) */
+static void
+sweet_fault_search(uint32_t seq, const char *what, const uint32_t *dw, uint32_t count, uint64_t far)
+{
+	uint32_t found = 0;
+	for (uint32_t i = 0; far != 0 && i + 1 < count && found < 12; i++) {
+		uint64_t v = dw[i] | ((uint64_t)dw[i + 1] << 32);
+		if (v != 0 && v <= far && far - v < (64ULL << 20) && (v >> 32) == (far >> 32)) {
+			IOLog("SWEET GPU: fault %u: %s word %u names %llx (far - %llx); before it %08x %08x\n", seq, what, i, v, far - v,
+			    i >= 2 ? dw[i - 2] : 0, i >= 1 ? dw[i - 1] : 0);
+			found++;
+		}
+	}
+}
+
+/* An IB's words around the CP and its addresses near far. dw 0: the size is not known, base is where the CP reads. */
+static uint32_t
+sweet_fault_ib(uint32_t seq, const char *what, uint64_t base, uint32_t dw, uint32_t pos, uint64_t far, uint32_t *buf, uint32_t cap)
+{
+	uint32_t got;
+	if (base == 0) {
+		return 0;
+	}
+	if (dw == 0) {
+		got = sweet_fault_read(base - 4 * 48, buf, 64);
+		if (got == 64) {
+			IOLog("SWEET GPU: fault %u: %s %llx: size not known, 48 words before it and 16 after\n", seq, what, base);
+			sweet_fault_dump(seq, what, buf, 0, 64, 48);
+			return 64;
+		}
+		got = sweet_fault_read(base, buf, 64);
+		IOLog("SWEET GPU: fault %u: %s %llx: size not known, %u words read from it\n", seq, what, base, got);
+		sweet_fault_dump(seq, what, buf, 0, got, 0);
+		return got;
+	}
+	got = sweet_fault_read(base, buf, dw < cap ? dw : cap);
+	IOLog("SWEET GPU: fault %u: %s %llx: %u words, the CP at word %u, %u read\n", seq, what, base, dw, pos, got);
+	if (got != 0) {
+		const uint32_t at = pos < got ? pos : got - 1, first = at > 56 ? at - 56 : 0, end = at + 8 < got ? at + 8 : got;
+		sweet_fault_dump(seq, what, buf + first, first, end - first, at);
+		sweet_fault_search(seq, what, buf, got, far);
+	}
+	return got;
+}
+
+extern "C" void
+sweet_accel_fault_describe(uint32_t seq, uint64_t far, uint64_t ib1, uint32_t ib1_dw, uint32_t ib1_pos, uint64_t ib2,
+    uint32_t ib2_rem)
+{
+	const uint32_t cap = 16384;
+	const uint64_t addr[2] = { far, ib1 };
+	const char *const what[2] = { "far", "ib1" };
+	if (gAccelClientsLock != NULL) {
+		IOLockLock(gAccelClientsLock);
+		for (unsigned a = 0; a < 2; a++) {
+			bool found = false;
+			for (unsigned i = 0; i < SWEET_DIAG_MAX_CLIENTS && !found; i++) {
+				found = gAccelClients[i] != NULL && gAccelClients[i]->describeIova(addr[a], what[a], seq);
+			}
+			if (!found) {
+				IOLog("SWEET GPU: fault %u: %s %llx: in no client's window\n", seq, what[a], addr[a]);
+			}
+		}
+		IOLockUnlock(gAccelClientsLock);
+	}
+	/* a buffer freed with BoFree, kept mapped until the fence of that moment */
+	if (sweet_retire_lock != NULL && far != 0) {
+		IOLockLock(sweet_retire_lock);
+		for (uint32_t i = 0; i < sweet_retire_count; i++) {
+			const struct sweet_v2_retired *e = &sweet_retire_ring[(sweet_retire_head + i) % SWEET_V2_RETIRE_CAP];
+			if (e->iova != 0 && far >= e->iova && far < e->iova + e->bytes) {
+				IOLog("SWEET GPU: fault %u: far is in a freed buffer %llx + %llx still waiting for fence %u (%s)\n", seq,
+				    e->iova, e->bytes, e->fence, sweet_gpu_fence_done(e->fence) ? "done" : "not done");
+			}
+		}
+		IOLockUnlock(sweet_retire_lock);
+	}
+	uint32_t *buf = IONew(uint32_t, cap);
+	if (buf == NULL) {
+		return;
+	}
+	uint32_t got = sweet_fault_ib(seq, "ib1", ib1, ib1_dw, ib1_pos, far, buf, cap), ib2_dw = 0;
+	/* IB2's size: the CP_INDIRECT_BUFFER in IB1 that names it (address low, high, words) */
+	for (uint32_t i = 0; ib2 != 0 && i + 2 < got; i++) {
+		if (buf[i] == (uint32_t)ib2 && buf[i + 1] == (uint32_t)(ib2 >> 32)) {
+			ib2_dw = buf[i + 2] & 0xfffff;
+		}
+	}
+	(void)sweet_fault_ib(seq, "ib2", ib2, ib2_dw, ib2_dw > ib2_rem ? ib2_dw - ib2_rem : 0, far, buf, cap);
+	IODelete(buf, uint32_t, cap);
+}
