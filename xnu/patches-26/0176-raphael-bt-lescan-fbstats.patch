diff --git a/bsd/dev/raphael_bt.c b/bsd/dev/raphael_bt.c
index 86477af..a9336c0 100644
--- a/bsd/dev/raphael_bt.c
+++ b/bsd/dev/raphael_bt.c
@@ -818,9 +818,85 @@ bt_fake_find(uint16_t op)
 	return NULL;
 }
 
+/*
+ * bluetoothd scans through Apple's vendor commands (0xfe37 scan parameters for the main and the low-power core,
+ * 0xfe29 scan enable), which this chip does not have. raphbtscan=1 (default): the kernel answers them (above)
+ * and issues the standard LE Set Scan Parameters / Set Scan Enable itself, so the WCN3998 really scans and its
+ * advertising reports reach bluetoothd. Their Command Complete events are not passed up.
+ * fe37 parameters as seen: 01 00 01 02 CORE 00 INTERVAL(2) WINDOW(2) 1e 00 (interval 0x1e0 = 300 ms, window
+ * 0x30 = 30 ms, as bluetoothd logs "Starting passive scan (300.00ms/30.00ms)"); fe29: ENABLE 02 01 02 ...
+ */
+static struct {
+	uint32_t on;
+	uint16_t interval, window;
+	unsigned own;           /* our LE commands whose Command Complete is still to come */
+	bool enabled;
+} bt_scan = { 1, 0x1e0, 0x30, 0, false };
+
+static void
+bt_scan_cmd(uint16_t op, const uint8_t *p, uint8_t plen)
+{
+	uint8_t c[4 + 8];
+	c[0] = 1;
+	c[1] = (uint8_t)op;
+	c[2] = (uint8_t)(op >> 8);
+	c[3] = plen;
+	memcpy(c + 4, p, plen);
+	bt.c_txerr += bt_tx(c, 4u + plen) != 0;
+	bt_scan.own++;
+}
+
+static void
+bt_scan_vendor(const uint8_t *d, size_t len)
+{
+	uint16_t op = (uint16_t)(d[1] | d[2] << 8);
+	if (!bt_scan.on) {
+		return;
+	}
+	if (op == 0xfe37 && len >= 4 + 10 && d[8] == 1) {      /* the main core's parameters */
+		bt_scan.interval = (uint16_t)(d[10] | d[11] << 8);
+		bt_scan.window = (uint16_t)(d[12] | d[13] << 8);
+	} else if (op == 0xfe29 && len >= 5) {
+		bool en = d[4] != 0;
+		if (en) {
+			uint16_t iv = bt_scan.interval >= 4 && bt_scan.interval <= 0x4000 ? bt_scan.interval : 0x1e0;
+			uint16_t wn = bt_scan.window >= 4 && bt_scan.window <= iv ? bt_scan.window : 0x30;
+			uint8_t sp[7] = { 0 /* passive */, (uint8_t)iv, (uint8_t)(iv >> 8), (uint8_t)wn, (uint8_t)(wn >> 8),
+				              0 /* public address */, 0 /* accept all */ };
+			if (bt_scan.enabled) {
+				uint8_t off[2] = { 0, 0 };
+				bt_scan_cmd(0x200c, off, 2);
+			}
+			bt_scan_cmd(0x200b, sp, 7);
+			uint8_t on[2] = { 1, 1 /* filter duplicates */ };
+			bt_scan_cmd(0x200c, on, 2);
+		} else if (bt_scan.enabled) {
+			uint8_t off[2] = { 0, 0 };
+			bt_scan_cmd(0x200c, off, 2);
+		}
+		if (en != bt_scan.enabled) {
+			printf("RAPH BT: LE scan %s (interval %u, window %u x 0.625 ms)\n", en ? "on" : "off",
+			    bt_scan.interval, bt_scan.window);
+		}
+		bt_scan.enabled = en;
+	}
+}
+
 static void
 bt_ctl_deliver(kern_ctl_ref ref, uint32_t unit)
 {
+	/* Command Complete / Status of the kernel's own LE scan commands */
+	if (bt_scan.own && fr.pk[0] == 4 && ((fr.pk[1] == 0x0e && fr.n >= 7 && fr.pk[5] == 0x20 &&
+	    (fr.pk[4] == 0x0b || fr.pk[4] == 0x0c)) || (fr.pk[1] == 0x0f && fr.n >= 7 && fr.pk[6] == 0x20 &&
+	    (fr.pk[5] == 0x0b || fr.pk[5] == 0x0c)))) {
+		bt_scan.own--;
+		uint8_t st = fr.pk[1] == 0x0e ? fr.pk[6] : fr.pk[3];
+		if (st != 0 && bt.c_log) {
+			printf("RAPH BT: own LE command %#06x: status %#x\n", fr.pk[1] == 0x0e ? fr.pk[4] | fr.pk[5] << 8 :
+			    fr.pk[5] | fr.pk[6] << 8, st);
+		}
+		return;
+	}
 	/* Read_Local_Supported_Commands: 04 0e len ncmd 02 10 status + 64 octets */
 	if (fr.pk[0] == 4 && fr.pk[1] == 0x0e && fr.n >= 7u + 64u && fr.pk[4] == 0x02 && fr.pk[5] == 0x10 &&
 	    fr.pk[6] == 0) {
@@ -932,6 +1008,8 @@ bt_ctl_connect(kern_ctl_ref ref, struct sockaddr_ctl *sac, void **unitinfo)
 	bt.c_epoch++;
 	bt.tail = bt.head;              /* nothing stale for the new client */
 	bt.c_log = 400;
+	bt_scan.enabled = false;
+	bt_scan.own = 0;
 	lck_mtx_unlock(&raph_bt_ctl);
 	*unitinfo = NULL;
 	printf("RAPH BT: %s: client connected (unit %u, controller %s, %u baud, pid %d %s)\n", BT_CTL_NAME,
@@ -1004,6 +1082,7 @@ bt_ctl_send(kern_ctl_ref ref, u_int32_t unit, __unused void *unitinfo, mbuf_t m,
 			 * answer must then carry at least 4 bytes.
 			 */
 			uint16_t op = (uint16_t)(d[1] | d[2] << 8);
+			bt_scan_vendor(d, len);
 			int ok = bt.vsc == 2 ? 0 : bt_vscok_find(op);
 			uint8_t ev[7 + 1 + 250];
 			bzero(ev, sizeof(ev));
@@ -1164,6 +1243,7 @@ raphael_bt_init(void)
 	(void)PE_parse_boot_argn("raphbtvsc", &bt.vsc, sizeof(bt.vsc));
 	bt_fake_parse();
 	bt_vscok_parse();
+	(void)PE_parse_boot_argn("raphbtscan", &bt_scan.on, sizeof(bt_scan.on));
 	bt_ctl_register();
 	printf("RAPH BT: /dev/raphael-bt ready (UART set up at first open)\n");
 }
diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
