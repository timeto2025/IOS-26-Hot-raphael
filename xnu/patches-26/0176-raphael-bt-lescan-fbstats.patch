+/* For the framebuffer's 5 s line: flips so far, frames drawn over while waiting, state (-1/0/1). */
+void sweet_gpu_flip_stats(uint64_t *flips, uint64_t *skipped, int *state);
+void
+sweet_gpu_flip_stats(uint64_t *flips, uint64_t *skipped, int *state)
+{
+	*flips = flip_count;
+	*skipped = flip_skipped;
+	*state = flip_state;
+}
+
 /* Before the CPU draws into frame 0 (the fallback path): put frame 0 back on screen. */
 void sweet_gpu_flip_reset(void);
 void
diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index a3e0e41..9eaa8c1 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -51,6 +51,8 @@ int sweet_gpu_surface_slot(uint64_t key);
 int sweet_gpu_map_surface(uint64_t key, const uint64_t *pages, uint32_t npages, uint32_t page_size);
 void sweet_gpu_flip_poll(void);
 void sweet_gpu_flip_reset(void);
+void sweet_gpu_flip_stats(uint64_t *flips, uint64_t *skipped, int *state);
+static const char *sweet_fb_last_fallback = "none";
 int sweet_gpu_present(int slot, uintptr_t kva, uint32_t offset, uint32_t w, uint32_t h, uint32_t pitch,
 	uint32_t fb_pitch, uint32_t corner_radius, uint32_t *out_dx, uint32_t *out_dy,
 	uint32_t *out_dw, uint32_t *out_dh);
@@ -335,8 +337,20 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 		fb->fLast5sFpsX10 = (uint32_t)(swaps * 2ULL);
 		IOLockUnlock(fb->fLock);
 		if (swaps || presents) {
-			IOLog("SWEET FB: 5s: %llu swaps (%llu.%llu fps), %llu panel copies, avg copy %llu us\n",
-			    swaps, swaps / 5, (swaps * 2) % 10, presents, avg_us);
+			/* raphael tearing check: GPU presents flip at TE; CPU ones draw into the frame on screen */
+			static uint64_t last_flips, last_skipped, last_gpu, last_cpu;
+			uint64_t flips = 0, skipped = 0;
+			int fstate = -1;
+			sweet_gpu_flip_stats(&flips, &skipped, &fstate);
+			IOLog("SWEET FB: 5s: %llu swaps (%llu.%llu fps), %llu panel copies, avg copy %llu us; "
+			    "gpu %llu cpu %llu (%s), flip %d: %llu flipped, %llu drawn over\n",
+			    swaps, swaps / 5, (swaps * 2) % 10, presents, avg_us, fb->fGpuPresents - last_gpu,
+			    fb->fCpuPresents - last_cpu, fb->fCpuPresents != last_cpu && sweet_fb_last_fallback ?
+			    sweet_fb_last_fallback : "-", fstate, flips - last_flips, skipped - last_skipped);
+			last_flips = flips;
+			last_skipped = skipped;
+			last_gpu = fb->fGpuPresents;
+			last_cpu = fb->fCpuPresents;
 		}
 	}
 	/*
@@ -508,7 +522,6 @@ AppleCLCD::refreshBrightness(void)
 
 static uint32_t sweet_fb_gpu_why_logged;
 static uint64_t sweet_fb_gpu_fallback_count;
-static const char *sweet_fb_last_fallback = "none";
 
 /* Why presentGPU fell back to the CPU copy, logged once per reason. */
