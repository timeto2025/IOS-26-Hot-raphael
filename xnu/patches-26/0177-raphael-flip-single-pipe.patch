From ccaa9c7596b4d1e1c15fe3a05bf8d3a56fa13d90 Mon Sep 17 00:00:00 2001
From: raphael port <noreply@example.invalid>
Date: Fri, 13 Nov 2026 17:38:40 +0300
Subject: [PATCH] raphael: page flip also when ABL scans out through VIG0 alone
 (VIG1 address 0, recovery boot)

---
 bsd/dev/sweet_gpu.c | 24 ++++++++++++++++--------
 1 file changed, 16 insertions(+), 8 deletions(-)

diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
index 2b6fcb7..bfb376a 100644
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -512,6 +512,8 @@ sweet_gpu_panel_stride(uint32_t stride)
 #define SSPP_SRC0_ADDR  0x14
 static int flip_state = -1;             /* -1 not set up yet, 0 off, 1 on */
 static uint32_t flip_off[2];            /* VIG0/VIG1 source address - frame base, as ABL set them */
+static int flip_pipes = 2;              /* 2: VIG0 + VIG1 split, 1: VIG0 alone (VIG1 address 0) */
+static uint32_t flip_flush = 0x3;       /* CTL0 flush bits of the pipes in use */
 static int flip_front, flip_pending = -1, flip_prev = -1;
 static uint32_t flip_pending_fence;
 static uint64_t flip_count, flip_skipped;
@@ -529,12 +531,16 @@ flip_setup_locked(void)
 		return;
 	}
 	uint32_t a0 = a6_rd(SSPP_VIG(0) + SSPP_SRC0_ADDR), a1 = a6_rd(SSPP_VIG(1) + SSPP_SRC0_ADDR);
-	if (a0 < A6_FB_PA || a0 >= A6_FB_PA + A6_FB_STEP || a1 < A6_FB_PA || a1 >= A6_FB_PA + A6_FB_STEP) {
+	/* ABL splits the panel over VIG0 + VIG1, or (booted from recovery) scans it out through VIG0 alone */
+	bool a1_ok = a1 >= A6_FB_PA && a1 < A6_FB_PA + A6_FB_STEP;
+	if (a0 < A6_FB_PA || a0 >= A6_FB_PA + A6_FB_STEP || (!a1_ok && a1 != 0)) {
 		a6_log("flip: VIG0 %#x / VIG1 %#x are not ABL's frame at %#llx: one buffer\n", a0, a1, A6_FB_PA);
 		return;
 	}
+	flip_pipes = a1_ok ? 2 : 1;
+	flip_flush = a1_ok ? 0x3 : 0x1;
 	flip_off[0] = a0 - (uint32_t)A6_FB_PA;
-	flip_off[1] = a1 - (uint32_t)A6_FB_PA;
+	flip_off[1] = a1_ok ? a1 - (uint32_t)A6_FB_PA : 0;
 	for (int i = 1; i < 3; i++) {
 		flip_cpu[i] = ml_io_map_unmappable((vm_offset_t)(A6_FB_PA + i * A6_FB_STEP), (vm_size_t)A6_FB_STEP,
 		    VM_WIMG_WCOMB);
@@ -546,8 +552,8 @@ flip_setup_locked(void)
 	}
 	flip_front = 0;
 	flip_state = 1;
-	a6_log("flip: three frames at %#llx + n * %#llx, VIG0/VIG1 offsets %#x/%#x, latched at TE\n", A6_FB_PA,
-	    A6_FB_STEP, flip_off[0], flip_off[1]);
+	a6_log("flip: three frames at %#llx + n * %#llx, %d pipe(s), VIG0/VIG1 offsets %#x/%#x, latched at TE\n",
+	    A6_FB_PA, A6_FB_STEP, flip_pipes, flip_off[0], flip_off[1]);
 #else
 	(void)on;
 #endif
@@ -558,8 +564,10 @@ flip_to_locked(int f)
 {
 	uint64_t base = A6_FB_PA + (uint64_t)f * A6_FB_STEP;
 	a6_wr(SSPP_VIG(0) + SSPP_SRC0_ADDR, (uint32_t)base + flip_off[0]);
-	a6_wr(SSPP_VIG(1) + SSPP_SRC0_ADDR, (uint32_t)base + flip_off[1]);
-	a6_wr(CTL0_FLUSH, 0x3);
+	if (flip_pipes == 2) {
+		a6_wr(SSPP_VIG(1) + SSPP_SRC0_ADDR, (uint32_t)base + flip_off[1]);
+	}
+	a6_wr(CTL0_FLUSH, flip_flush);
 	flip_prev = flip_front;
 	flip_front = f;
 }
@@ -568,7 +576,7 @@ flip_to_locked(int f)
 static int
 flip_target_locked(void)
 {
-	bool latched = (a6_rd(CTL0_FLUSH) & 0x3) == 0;
+	bool latched = (a6_rd(CTL0_FLUSH) & flip_flush) == 0;
 	for (int f = 0; f < 3; f++) {
 		if (f != flip_front && f != flip_pending && (latched || f != flip_prev)) {
 			return f;
@@ -584,7 +592,7 @@ static void
 flip_poll_locked(void)
 {
 	if (flip_state != 1 || flip_pending < 0 || !a6_fence_done(&gpu, flip_pending_fence) ||
-	    (a6_rd(CTL0_FLUSH) & 0x3) != 0) {
+	    (a6_rd(CTL0_FLUSH) & flip_flush) != 0) {
 		return;
 	}
 	flip_to_locked(flip_pending);
-- 
2.43.0

