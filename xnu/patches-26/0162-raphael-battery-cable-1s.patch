From 3404e1590800ee938c76d0834dd7ed9238fa4a30 Mon Sep 17 00:00:00 2001
From: raphael port <noreply@example.invalid>
Date: Thu, 12 Nov 2026 23:39:17 +0300
Subject: [PATCH] raphael: battery: follow the charger cable within a second

---
 bsd/dev/rmx1931_battery.c | 60 +++++++++++++++++++++++----------------
 1 file changed, 36 insertions(+), 24 deletions(-)

diff --git a/bsd/dev/rmx1931_battery.c b/bsd/dev/rmx1931_battery.c
index 3164edb..9ca89f2 100644
--- a/bsd/dev/rmx1931_battery.c
+++ b/bsd/dev/rmx1931_battery.c
@@ -553,33 +553,45 @@ fg_thread(void *arg __unused, wait_result_t wr __unused)
 {
 	bq_wait_ms(1500);
 	(void)sweet_spmi_init();
-	unsigned logged = 0, errors = 0;
+	unsigned logged = 0, errors = 0, since_full = 1000;
+	uint8_t last_usb = 0xff, last_chg = 0xff;
 	for (;;) {
-		struct rmx1931_battery_state st;
-		uint8_t raw = 0;
-		if (fg_poll_once(&st, &raw)) {
-			errors = 0;
-			bq_last_state = st;
-			sys_bat_soc = (int)st.soc;
-			sys_bat_mv = (int)st.voltage_mv;
-			sys_bat_ma = st.current_ma;
-			sys_bat_charging = st.charging ? 1 : 0;
-			sys_bat_external = st.external_connected ? 1 : 0;
-			sys_bat_fcc_mah = (int)st.fcc_mah;
-			SweetBatteryReport(&st);
-			if (logged < 4 || (logged % 20u) == 0) {
-				printf("RAPH BATTERY: soc=%u%% (fg %u/255) %umV %dmA (raw %#x %#x) ext=%d chg=%d full=%d\n",
-				    st.soc, raw, st.voltage_mv, st.current_ma, fg_raw_mv, fg_raw_ma,
-				    st.external_connected, st.charging, st.full);
-			}
-			logged++;
-		} else {
-			bq_total_errors++;
-			if ((errors++ % 10u) == 0) {
-				printf("RAPH BATTERY: PM8150B FG read error (%u)\n", errors);
+		/* the charger's plug-in and state bits every second, the fuel gauge every 15 s or when they change:
+		 * the charging icon follows the cable within about a second */
+		uint8_t usb = 0, chg = 0;
+		bool plug_ok = sweet_spmi_read(2, 0x1310u, &usb) == 0 && sweet_spmi_read(2, 0x1006u, &chg) == 0;
+		bool changed = plug_ok && ((usb & 0x10u) != (last_usb & 0x10u) || (chg & 7u) != (last_chg & 7u));
+		if (changed || since_full >= 15) {
+			struct rmx1931_battery_state st;
+			uint8_t raw = 0;
+			since_full = 0;
+			if (fg_poll_once(&st, &raw)) {
+				errors = 0;
+				last_usb = usb;
+				last_chg = chg;
+				bq_last_state = st;
+				sys_bat_soc = (int)st.soc;
+				sys_bat_mv = (int)st.voltage_mv;
+				sys_bat_ma = st.current_ma;
+				sys_bat_charging = st.charging ? 1 : 0;
+				sys_bat_external = st.external_connected ? 1 : 0;
+				sys_bat_fcc_mah = (int)st.fcc_mah;
+				SweetBatteryReport(&st);
+				if (logged < 4 || changed || (logged % 20u) == 0) {
+					printf("RAPH BATTERY: soc=%u%% (fg %u/255) %umV %dmA (raw %#x %#x) ext=%d chg=%d full=%d%s\n",
+					    st.soc, raw, st.voltage_mv, st.current_ma, fg_raw_mv, fg_raw_ma,
+					    st.external_connected, st.charging, st.full, changed ? " (cable/state change)" : "");
+				}
+				logged++;
+			} else {
+				bq_total_errors++;
+				if ((errors++ % 10u) == 0) {
+					printf("RAPH BATTERY: PM8150B FG read error (%u)\n", errors);
+				}
 			}
 		}
-		bq_wait_ms(logged <= 4 ? 5000 : 15000);
+		since_full++;
+		bq_wait_ms(1000);
 	}
 }
 #endif /* SWEET_BOARD_RAPHAEL */
-- 
2.43.0

