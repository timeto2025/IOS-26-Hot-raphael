 			    sweet_fb_last_fallback : "-", fstate, flips - last_flips, skipped - last_skipped);
+			if (held_total != last_held) {
+				IOLog("SWEET FB: 5s: %llu vsync notifications held (two frames waited)\n", held_total - last_held);
+				last_held = held_total;
+			}
 			last_flips = flips;
 			last_skipped = skipped;
 			last_gpu = fb->fGpuPresents;
@@ -369,7 +376,9 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 	for (unsigned int i = 0; i < fb->fClients->getCount(); i++) {
 		IOMobileFramebufferUserClient *client =
 		    (IOMobileFramebufferUserClient *)fb->fClients->getObject(i);
-		client->notify(SWEET_FB_NOTIFY_VSYNC, values, 6);
+		if (!hold) {    /* two frames wait for their flip: the clients are not asked for another one at this tick */
