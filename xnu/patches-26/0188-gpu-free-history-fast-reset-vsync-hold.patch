 #endif
@@ -272,6 +274,9 @@ gpu_thread(void *arg __unused, wait_result_t wr __unused)
 	uint32_t hupcf = 1;
 	(void)PE_parse_boot_argn("sweetgpuhupcf", &hupcf, sizeof(hupcf));
 	a6_hupcf = hupcf != 0;
