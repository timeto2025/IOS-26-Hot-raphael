 	int rc = a6_power_up(&gpu);
 	if (!rc) {
@@ -531,10 +536,17 @@ gpu_kill_lost_later(uint32_t lo, uint32_t hi)
  */
 #define IB_HIST         256
 #define UNMAP_HIST      128
-static struct { uint64_t iova; uint32_t dwords, fence; int pid; } ib_hist[IB_HIST];
+static struct { uint64_t iova, abs; uint32_t dwords, fence; int pid; } ib_hist[IB_HIST];
 static uint32_t ib_hist_n;
 static struct { uint64_t iova, len, abs; } unmap_hist[UNMAP_HIST];
 static uint32_t unmap_hist_n;
+/* BoFree as the client called it (0188): when, by whom, and the last fence submitted then, which the unmap waits for. With the
+ * faulting IB's own submit time this tells a buffer freed before the IB that names it was submitted (the client's error: nothing
+ * in the kernel can know of that IB) from one unmapped although the IB was already in the ring (ours). */
+#define FREE_HIST       256
+static struct { uint64_t iova, len, abs; uint32_t fence; int pid; } free_hist[FREE_HIST];
+static uint32_t free_hist_n;
+static uint64_t fault_ended_abs;
 static uint64_t fault_count, fault_log_abs;
 static uint32_t fault_logged;
 static thread_call_t fault_tc;
@@ -547,6 +559,21 @@ static bool fault_rec_pending;
 void sweet_accel_fault_describe(uint32_t seq, uint64_t far, uint64_t ib1, uint32_t ib1_dw, uint32_t ib1_pos, uint64_t ib2,
     uint32_t ib2_rem);
 
+void sweet_gpu_note_free(uint64_t iova, uint64_t len, uint32_t fence);
+
+void
+sweet_gpu_note_free(uint64_t iova, uint64_t len, uint32_t fence)
+{
+	lck_mtx_lock(&sweet_gpu_lock);
+	free_hist[free_hist_n % FREE_HIST].iova = iova;
+	free_hist[free_hist_n % FREE_HIST].len = len;
+	free_hist[free_hist_n % FREE_HIST].abs = mach_absolute_time();
+	free_hist[free_hist_n % FREE_HIST].fence = fence;
+	free_hist[free_hist_n % FREE_HIST].pid = proc_selfpid();
+	free_hist_n++;
+	lck_mtx_unlock(&sweet_gpu_lock);
+}
+
 static void
 gpu_unmap_note_locked(uint64_t iova, uint64_t len)
 {
@@ -617,6 +644,29 @@ gpu_fault_log_locked(const char *why, uint32_t fsr, uint64_t far, uint32_t syn,
 	if (un_len != 0) {
 		a6_log("fault %u: far lies in %llx + %llx, unmapped %llu ms before\n", seq, un_iova, un_len, un_ms);
 	}
+	/* the newest BoFree of a buffer that held far, against the submit of the IB the CP is in */
+	for (uint32_t i = 0; i < FREE_HIST && i < free_hist_n && fsr != 0; i++) {
+		uint32_t k = (free_hist_n - 1 - i) % FREE_HIST;
+		if (far >= free_hist[k].iova && far < free_hist[k].iova + free_hist[k].len) {
+			uint64_t free_ms = 0, ib_ms = 0;
+			char who[32] = "?";
+			absolutetime_to_nanoseconds(now - free_hist[k].abs, &ns);
+			free_ms = ns / 1000000ULL;
+			if (hit >= 0) {
+				absolutetime_to_nanoseconds(now - ib_hist[hit].abs, &ns);
+				ib_ms = ns / 1000000ULL;
+			}
+			if (free_hist[k].pid > 0) {
+				proc_name(free_hist[k].pid, who, sizeof(who));
+			}
+			a6_log("fault %u: far lies in %llx + %llx, freed by %s[%d] %llu ms before, last fence then %u; the IB (fence %u) "
+			    "was submitted %llu ms before: %s\n", seq, free_hist[k].iova, free_hist[k].len, who, free_hist[k].pid,
+			    free_ms, free_hist[k].fence, hit >= 0 ? ib_hist[hit].fence : 0, ib_ms,
+			    hit < 0 ? "the IB's submit is not in the history" :
+			    free_hist[k].abs < ib_hist[hit].abs ? "freed before the IB was submitted" : "freed after the IB was submitted");
+			break;
+		}
+	}
 	if (!fault_rec_pending) {
 		fault_rec.seq = seq;
 		fault_rec.far = fsr != 0 ? far : 0;
@@ -657,9 +707,25 @@ gpu_fault_service_locked(const char *why)
 		gpu_fault_log_locked(why, fsr, far, syn, false);
 	}
 	(void)a6_end_fault(&gpu);
+	fault_ended_abs = now;
 	return true;
 }
 
+/*
+ * How long the GPU may stand still before the reset. After a fault that was ended the CP was seen to stay where it was (0187 on
+ * the phone: fault 1 at 461.578 s, the same IB1/IB2 words at the reset 1 s later): 150 ms then, the longest job seen ran 30 ms.
+ */
+static uint32_t
+gpu_hang_ms_locked(void)
+{
+	uint64_t ns = 0;
+	if (fault_ended_abs == 0) {
+		return 1000;
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - fault_ended_abs, &ns);
+	return ns < 2000000000ULL ? 150 : 1000;
+}
+
 /* Soft reset + CP re-init; everything queued is lost, its fences complete at once (waiters return). */
 static void
 gpu_recover_locked(const char *why)
@@ -876,6 +942,45 @@ sweet_gpu_flip_poll(void)
 	lck_mtx_unlock(&sweet_gpu_lock);
 }
 
+/*
+ * Vsync notifications held back while two frames wait (0188, off unless sweetvsynchold=1 or the command "vsynchold 1").
+ * backboardd draws a frame for every vsync notification and the swap does not wait: scrolling Settings on raphael it
+ * made 50 frames a second, the GPU (90 % busy, 18 ms a frame) was up to three behind, and 66 to 96 of 250 frames in 5 s
+ * were drawn over before they were shown, 34 a second reached the panel. A notification that is not sent while two frames
+ * wait keeps backboardd from drawing a frame that cannot be shown; never more than two in a row.
+ */
+static uint32_t vsync_hold_run;
+static uint64_t vsync_held;
+
+void sweet_gpu_set_vsync_hold(int on);
+void
+sweet_gpu_set_vsync_hold(int on)
+{
+	lck_mtx_lock(&sweet_gpu_lock);
+	vsync_hold = on != 0;
+	vsync_hold_run = 0;
+	lck_mtx_unlock(&sweet_gpu_lock);
+}
+
+/* From the vsync timer: true = do not notify the clients of this tick. *held: how many were held so far. */
+bool sweet_gpu_vsync_hold_now(uint64_t *held);
+bool
+sweet_gpu_vsync_hold_now(uint64_t *held)
+{
+	bool hold = false;
+	lck_mtx_lock(&sweet_gpu_lock);
+	if (vsync_hold && flip_state == 1 && flip_pend[0] >= 0 && flip_pend[1] >= 0 && vsync_hold_run < 2) {
+		hold = true;
+		vsync_hold_run++;
+		vsync_held++;
+	} else {
+		vsync_hold_run = 0;
+	}
+	*held = vsync_held;
+	lck_mtx_unlock(&sweet_gpu_lock);
+	return hold;
+}
+
 /* For the framebuffer's 5 s line: flips so far, frames drawn over while waiting, state (-1/0/1). */
 void sweet_gpu_flip_stats(uint64_t *flips, uint64_t *skipped, int *state);
 void
@@ -1848,6 +1953,7 @@ sweet_gpu_submit_v2(const uint64_t *iova, const uint32_t *dwords, unsigned n, bo
 		ib_hist[ib_hist_n % IB_HIST].dwords = dwords[i];
 		ib_hist[ib_hist_n % IB_HIST].fence = fence;
 		ib_hist[ib_hist_n % IB_HIST].pid = proc_selfpid();
+		ib_hist[ib_hist_n % IB_HIST].abs = mach_absolute_time();
 		ib_hist_n++;
 	}
 	lck_mtx_unlock(&sweet_gpu_lock);
@@ -1891,7 +1997,7 @@ sweet_gpu_wait_fence_ns(uint32_t fence, uint64_t timeout_ns)
 			last_check = now;
 			lck_mtx_lock(&sweet_gpu_lock);
 			(void)gpu_fault_service_locked("v2 fence wait");
-			if (!a6_fence_done(&gpu, fence) && gpu_hung_locked(1000)) {
+			if (!a6_fence_done(&gpu, fence) && gpu_hung_locked(gpu_hang_ms_locked())) {
 				gpu_recover_locked("v2 fence wait");
 			}
 			lck_mtx_unlock(&sweet_gpu_lock);
