From 147c476791ce7dbf8e5c9dd0e220d2ea7ff0872a Mon Sep 17 00:00:00 2001
From: raphael port <noreply@example.invalid>
Date: Sat, 14 Nov 2026 00:59:16 +0300
Subject: [PATCH] sweet GPU: after a reset, restart the processes whose GPU
 work was lost (UI stuck on the Apple logo after a fault on SpringBoard's
 first frame)

---
 bsd/dev/sweet_gpu.c                   | 53 +++++++++++++++++++++++++++
 iokit/Kernel/arm/SweetAccelerator.cpp | 28 ++++++++++++++
 2 files changed, 81 insertions(+)

diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
index 104d075..154f2cf 100644
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -18,6 +18,7 @@
 #include <sys/param.h>
 #include <sys/systm.h>
 #include <sys/proc.h>
+#include <sys/signalvar.h>
 #include <kern/locks.h>
 #include <kern/thread.h>
 #include <kern/clock.h>
@@ -456,6 +457,57 @@ gpu_hung_locked(uint32_t hang_ms)
 	return ns > hang_ms * 1000000ULL;
 }
 
+/*
+ * After a reset, restart the processes whose work it threw away: their GPU state is gone and HotMetal does
+ * not rebuild it, so SpringBoard/backboardd kept showing the last frame (raphael: a translation fault on
+ * SpringBoard's first frame left the Apple logo up; killing both by hand brought the UI back). launchd
+ * starts them again. Boot-arg sweetgpukill=0 leaves them alone.
+ */
+unsigned sweet_accel_lost_pids(uint32_t lo, uint32_t hi, int *pids, unsigned max);
+static thread_call_t kill_tc;
+static uint32_t kill_lo, kill_hi;
+
+static void
+gpu_kill_lost(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	int pids[16];
+	unsigned n = sweet_accel_lost_pids(kill_lo, kill_hi, pids, 16);
+	for (unsigned i = 0; i < n; i++) {
+		char name[32] = "?";
+		if (pids[i] <= 1) {
+			continue;
+		}
+		proc_t p = proc_find(pids[i]);
+		if (p == NULL) {
+			continue;
+		}
+		proc_name(pids[i], name, sizeof(name));
+		a6_log("recover: restarting %s[%d] (its GPU work was lost)\n", name, pids[i]);
+		psignal(p, SIGKILL);
+		proc_rele(p);
+	}
+}
+
+static void
+gpu_kill_lost_later(uint32_t lo, uint32_t hi)
+{
+	uint32_t on = 1;
+	PE_parse_boot_argn("sweetgpukill", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	if (kill_tc == NULL) {
+		kill_tc = thread_call_allocate_with_priority(gpu_kill_lost, NULL, THREAD_CALL_PRIORITY_KERNEL);
+	}
+	if (kill_tc != NULL) {
+		kill_lo = lo;
+		kill_hi = hi;
+		uint64_t dl;
+		clock_interval_to_deadline(200, NSEC_PER_MSEC, &dl);
+		thread_call_enter_delayed(kill_tc, dl);
+	}
+}
+
 /* Soft reset + CP re-init; everything queued is lost, its fences complete at once (waiters return). */
 static void
 gpu_recover_locked(const char *why)
@@ -472,6 +524,7 @@ gpu_recover_locked(const char *why)
 	lost[recoveries % LOST_RING].lo = done;
 	lost[recoveries % LOST_RING].hi = gpu.fence;
 	recoveries++;
+	gpu_kill_lost_later(done, gpu.fence);
 	if (a6_recover(&gpu)) {
 		a6_log("%s: GPU not recovered\n", why);
 		gpu_ready = false;
diff --git a/iokit/Kernel/arm/SweetAccelerator.cpp b/iokit/Kernel/arm/SweetAccelerator.cpp
index 10d7cf2..7787bd2 100644
--- a/iokit/Kernel/arm/SweetAccelerator.cpp
+++ b/iokit/Kernel/arm/SweetAccelerator.cpp
@@ -170,6 +170,10 @@ class SweetAcceleratorUserClient : public IOUserClient {
 	uint32_t fBOCap;
 	uint64_t *fPageBuf;
 	uint64_t fEpoch, fFaults;       /* GPU resets seen; those that lost this client's work */
+public:
+	uint32_t lastFence() const { return fLastFence; }
+	int pid() const { return fPid; }
+private:
 	uint64_t fPoolBytes, fPoolPeak; /* GPU pool memory this client holds */
 	uint64_t fSubmits;
 	int      fPid;
@@ -1292,6 +1296,30 @@ SweetAcceleratorUserClient::fillClientDiag(struct sweet_diag_gpu_client *out)
 	out->faults = fFaults;
 }
 
+/*
+ * After a GPU reset: the pids of the clients whose last submitted fence was in (lo, hi], the work
+ * the reset threw away. Their GPU state is gone (HotMetal does not rebuild it), so the kernel
+ * restarts them (bsd/dev/sweet_gpu.c), as killing SpringBoard by hand brought the UI back.
+ */
+extern "C" unsigned
+sweet_accel_lost_pids(uint32_t lo, uint32_t hi, int *pids, unsigned max)
+{
+	unsigned n = 0;
+	if (gAccelClientsLock == NULL) {
+		return 0;
+	}
+	IOLockLock(gAccelClientsLock);
+	for (unsigned i = 0; i < SWEET_DIAG_MAX_CLIENTS && n < max; i++) {
+		SweetAcceleratorUserClient *c = gAccelClients[i];
+		if (c != NULL && c->lastFence() != 0 && (int32_t)(c->lastFence() - lo) > 0 &&
+		    (int32_t)(hi - c->lastFence()) >= 0) {
+			pids[n++] = c->pid();
+		}
+	}
+	IOLockUnlock(gAccelClientsLock);
+	return n;
+}
+
 extern "C" void
 sweet_accel_diag_snapshot(struct sweet_diag_gpu *out)
 {
-- 
2.43.0

