From d52c67abc4af4c6e428842d032e9451bf1885e2a Mon Sep 17 00:00:00 2001
From: raphael port <noreply@example.invalid>
Date: Fri, 13 Nov 2026 03:17:50 +0300
Subject: [PATCH] raphael: fill the panel (no side bars), raphfill=0 fits by
 height

---
 bsd/dev/sweet_gpu.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
index 430f3e8..e15b6dd 100644
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -803,6 +803,23 @@ sweet_gpu_present(int s, uintptr_t kva, uint32_t offset, uint32_t w, uint32_t h,
 	if (PANEL_W > frame.dw && PANEL_W - frame.dw <= 2) {
 		frame.dw = PANEL_W;
 	}
+#if SWEET_BOARD_RAPHAEL
+	/*
+	 * raphael: the iPhone canvas (1125x2499) is a little narrower than the panel (1080x2340): fitted
+	 * by height it left 13-pixel black bars at both sides. Fill the panel instead (x 0.960, y 0.936:
+	 * 2.5 % narrower circles, not visible) unless raphfill=0. Touch follows sweet_display_fit_*.
+	 */
+	static int fill = -1;
+	if (fill < 0) {
+		uint32_t v = 1;
+		PE_parse_boot_argn("raphfill", &v, sizeof(v));
+		fill = v != 0;
+	}
+	if (fill) {
+		frame.dw = PANEL_W;
+		frame.dh = PANEL_H;
+	}
+#endif
 	frame.dx = (PANEL_W - frame.dw) / 2;
 	frame.dy = (PANEL_H - frame.dh) / 2;
 	uint32_t ext = corner_radius ? sweet_display_corner_extent(corner_radius) : 0;
-- 
