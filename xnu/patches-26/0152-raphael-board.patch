 #include <vm/vm_kern_xnu.h>
 #include <pexpert/pexpert.h>
 #include <libkern/libkern.h>
+#include <pexpert/arm64/board_config.h>
+#if !defined(SWEET_BOARD_RAPHAEL)
+#error "SWEET_BOARD_RAPHAEL must come from pexpert/arm64/SWEET.h"
+#endif
 
 extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
 extern boolean_t pmap_valid_address(uint64_t pa);
@@ -115,6 +119,11 @@ static LCK_MTX_DECLARE(sweet_pmem_lock, &sweet_pmem_grp);
 static inline bool
 pm_is_wcomb(uint64_t pa)
 {
+#if SWEET_BOARD_RAPHAEL
+	/* RMX1931's MPSS/ADSP carve-outs; raphael's are not mapped yet. Device memory is slow but safe. */
+	(void)pa;
+	return false;
+#endif
 	return (pa >= PMEM_MPSS_PA && pa < PMEM_MPSS_END) ||
 	       (pa >= PMEM_ADSP_PA && pa < PMEM_ADSP_END);
 }
diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 5c8a75f..184518b 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -39,6 +39,10 @@
 #include <pexpert/device_tree.h>
 #include <libkern/libkern.h>
 #include <machine/atomic.h>
+#include <pexpert/arm64/board_config.h>
+#if !defined(SWEET_BOARD_RAPHAEL)
+#error "SWEET_BOARD_RAPHAEL must come from pexpert/arm64/SWEET.h"
+#endif
 
 extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
 /* osfmk/arm/machine_routines.h, not exported to the BSD layer */
@@ -610,6 +614,14 @@ sweet_ufs_init(void)
 	PE_parse_boot_argn("ufsroot", want, sizeof(want));
 	uint32_t rw = 0;
 	PE_parse_boot_argn("ufsrw", &rw, sizeof(rw));
+#if SWEET_BOARD_RAPHAEL
+	/* On raphael "userdata" is Android's live f2fs: never open it writable (the
+	 * console log ring would overwrite its last 4 MiB). iOS goes on its own partition. */
+	if (rw && strcmp(want, "userdata") == 0) {
+		printf("SWEET UFS: raphael: refusing ufsrw=1 on userdata (Android); read-only\n");
+		rw = 0;
+	}
+#endif
 	uint32_t cache = 1, wait = 1;
 	PE_parse_boot_argn("ufscache", &cache, sizeof(cache));
 	PE_parse_boot_argn("ufswait", &wait, sizeof(wait));
