@@ -57,10 +57,18 @@
  * panel, 4320-byte rows). SWEET_EARLY_FB_BLOCK_PA is the 32MB L2 block
  * [0x9c000000, 0x9e000000) mapped Device-GRE holding it.
  */
-#define SWEET_EARLY_FB_PA         0x9d000000
+/*
+ * Redmi K20 Pro / Mi 9T Pro (raphael): same SM8150 silicon, different board.
+ * Splash framebuffer at reserved-memory cont_splash_region 0x9c000000,
+ * 1080x2340 command-mode panel with TE, no DSC (measured by the raphael
+ * zero-write shim probe: sspp vig0 1080x2340 addr 9c000000 stride 10e0).
+ * SWEET_BOARD_RAPHAEL switches off every RMX1931-only peripheral driver.
+ */
+#define SWEET_BOARD_RAPHAEL       1
+#define SWEET_EARLY_FB_PA         0x9c000000
 #define SWEET_EARLY_FB_BLOCK_PA   0x9c000000
 #define SWEET_EARLY_FB_WIDTH      1080
-#define SWEET_EARLY_FB_HEIGHT     2400
+#define SWEET_EARLY_FB_HEIGHT     2340
 #define SWEET_EARLY_FB_STRIDE     4320
 
 #define GIC_SPURIOUS_IRQ          1023    // IRQ no. for GIC spurious interrupt
