From a7f3668557764b19c68478d0f29f877f986aeb17 Mon Sep 17 00:00:00 2001
From: raphael port <noreply@example.invalid>
Date: Fri, 13 Nov 2026 00:57:19 +0300
Subject: [PATCH] raphael: page flip: three frames in cont_splash, VIG0/VIG1
 switched and latched at TE

---
 bsd/dev/sweet_a6xx.h                  |   3 +-
 bsd/dev/sweet_gpu.c                   | 141 +++++++++++++++++++++++++-
 iokit/Kernel/arm/SweetFramebuffer.cpp |   6 ++
 3 files changed, 147 insertions(+), 3 deletions(-)

diff --git a/bsd/dev/sweet_a6xx.h b/bsd/dev/sweet_a6xx.h
index 3f6cc87..47ab8bb 100644
--- a/bsd/dev/sweet_a6xx.h
+++ b/bsd/dev/sweet_a6xx.h
@@ -49,7 +49,8 @@
 #define A6_RING_DW		(A6_RING_SIZE / 4)
 
 #define A6_FB_PA		0x9c000000ull	/* raphael cont_splash_region */
-#define A6_FB_SIZE		0xa00000ull	/* mapped for the GPU: 5 x 2 MB */
+#define A6_FB_SIZE		0x1e00000ull	/* mapped for the GPU: 3 frames of 10 MB (raphael page flip), 15 x 2 MB */
+#define A6_FB_STEP		0xa00000ull	/* one frame buffer in cont_splash (36 MB, from 0x9c000000) */
 
 #define A6_GPU_ID		640
 #define A6_CHIP_ID		0x06040001ull
diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
index f2e8ced..430f3e8 100644
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -497,6 +497,132 @@ sweet_gpu_panel_stride(uint32_t stride)
 	a6_log("panel stride %u\n", stride);
 }
 
+/*
+ * ---- raphael page flip ----
+ *
+ * The panel is command-mode DSI: it refreshes from the frame the display controller hands it at every TE pulse.
+ * Blitting the next frame into the one frame being scanned out (what the present did) shows half-old,
+ * half-new frames and repeats or drops frames at random: the judder in scrolling. Instead three frames
+ * live in ABL's cont_splash (36 MB at 0x9c000000, 10 MB apart): the GPU draws into one that is neither on
+ * screen nor waiting, and once its blit has landed VIG0/VIG1 are pointed at it and CTL0 flushed, which
+ * the display controller latches at the next TE (ABL leaves autorefresh on). Same idea as HackiOS's raphael
+ * scanout (HeliumStudio-Dev/hackios-xnu-kernel, APSL 2.0: three buffers, VIG0/CTL0, TE latch), here for
+ * ABL's two-pipe split (VIG0 and VIG1, 540 columns each). Boot-arg raphflip=0: one buffer, as before.
+ */
+#define SSPP_SRC0_ADDR  0x14
+static int flip_state = -1;             /* -1 not set up yet, 0 off, 1 on */
+static uint32_t flip_off[2];            /* VIG0/VIG1 source address - frame base, as ABL set them */
+static int flip_front, flip_pending = -1, flip_prev = -1;
+static uint32_t flip_pending_fence;
+static uint64_t flip_count, flip_skipped;
+static vm_offset_t flip_cpu[3];
+
+static void
+flip_setup_locked(void)
+{
+	uint32_t on = 1;
+	flip_state = 0;
+#if SWEET_BOARD_RAPHAEL
+	PE_parse_boot_argn("raphflip", &on, sizeof(on));
+	if (!on) {
+		a6_log("flip: off (raphflip=0)\n");
+		return;
+	}
+	uint32_t a0 = a6_rd(SSPP_VIG(0) + SSPP_SRC0_ADDR), a1 = a6_rd(SSPP_VIG(1) + SSPP_SRC0_ADDR);
+	if (a0 < A6_FB_PA || a0 >= A6_FB_PA + A6_FB_STEP || a1 < A6_FB_PA || a1 >= A6_FB_PA + A6_FB_STEP) {
+		a6_log("flip: VIG0 %#x / VIG1 %#x are not ABL's frame at %#llx: one buffer\n", a0, a1, A6_FB_PA);
+		return;
+	}
+	flip_off[0] = a0 - (uint32_t)A6_FB_PA;
+	flip_off[1] = a1 - (uint32_t)A6_FB_PA;
+	for (int i = 1; i < 3; i++) {
+		flip_cpu[i] = ml_io_map_unmappable((vm_offset_t)(A6_FB_PA + i * A6_FB_STEP), (vm_size_t)A6_FB_STEP,
+		    VM_WIMG_WCOMB);
+		if (!flip_cpu[i]) {
+			a6_log("flip: frame %d not mapped: one buffer\n", i);
+			return;
+		}
+		bzero((void *)flip_cpu[i], (size_t)A6_FB_STEP);     /* black borders around the fitted picture */
+	}
+	flip_front = 0;
+	flip_state = 1;
+	a6_log("flip: three frames at %#llx + n * %#llx, VIG0/VIG1 offsets %#x/%#x, latched at TE\n", A6_FB_PA,
+	    A6_FB_STEP, flip_off[0], flip_off[1]);
+#else
+	(void)on;
+#endif
+}
+
+static void
+flip_to_locked(int f)
+{
+	uint64_t base = A6_FB_PA + (uint64_t)f * A6_FB_STEP;
+	a6_wr(SSPP_VIG(0) + SSPP_SRC0_ADDR, (uint32_t)base + flip_off[0]);
+	a6_wr(SSPP_VIG(1) + SSPP_SRC0_ADDR, (uint32_t)base + flip_off[1]);
+	a6_wr(CTL0_FLUSH, 0x3);
+	flip_prev = flip_front;
+	flip_front = f;
+}
+
+/* The frame the next present draws into: not on screen, not just left (until the flush latched), not waiting. */
+static int
+flip_target_locked(void)
+{
+	bool latched = (a6_rd(CTL0_FLUSH) & 0x3) == 0;
+	for (int f = 0; f < 3; f++) {
+		if (f != flip_front && f != flip_pending && (latched || f != flip_prev)) {
+			return f;
+		}
+	}
+	/* all three busy: draw over the one still waiting (the GPU runs in order; the flip waits for the new fence) */
+	flip_skipped++;
+	return flip_pending >= 0 ? flip_pending : (flip_front + 1) % 3;
+}
+
+/* A finished frame goes on screen once the previous flip latched. From the present and every vsync tick. */
+static void
+flip_poll_locked(void)
+{
+	if (flip_state != 1 || flip_pending < 0 || !a6_fence_done(&gpu, flip_pending_fence) ||
+	    (a6_rd(CTL0_FLUSH) & 0x3) != 0) {
+		return;
+	}
+	flip_to_locked(flip_pending);
+	flip_pending = -1;
+	if (++flip_count <= 3 || (flip_count % 3600) == 0) {
+		a6_log("flip: %llu frames flipped (now %d), %llu drawn over while waiting\n", flip_count, flip_front,
+		    flip_skipped);
+	}
+}
+
+void sweet_gpu_flip_poll(void);
+void
+sweet_gpu_flip_poll(void)
+{
+	if (flip_state != 1 || !gpu_ready) {
+		return;
+	}
+	lck_mtx_lock(&sweet_gpu_lock);
+	flip_poll_locked();
+	lck_mtx_unlock(&sweet_gpu_lock);
+}
+
+/* Before the CPU draws into frame 0 (the fallback path): put frame 0 back on screen. */
+void sweet_gpu_flip_reset(void);
+void
+sweet_gpu_flip_reset(void)
+{
+	if (flip_state != 1) {
+		return;
+	}
+	lck_mtx_lock(&sweet_gpu_lock);
+	flip_pending = -1;
+	if (flip_front != 0) {
+		flip_to_locked(0);
+	}
+	lck_mtx_unlock(&sweet_gpu_lock);
+}
+
 /* ---- surfaces ---- */
 
 static int present_wait_locked(uint32_t k, const char *why);
@@ -685,6 +811,13 @@ sweet_gpu_present(int s, uintptr_t kva, uint32_t offset, uint32_t w, uint32_t h,
 	}
 	static uint32_t ib[16 * A6_BLIT_MAX_DW];
 	lck_mtx_lock(&sweet_gpu_lock);
+	if (flip_state < 0) {
+		flip_setup_locked();
+	}
+	flip_poll_locked();
+	int target = flip_state == 1 ? flip_target_locked() : 0;
+	uint64_t fbdst = A6_GVA_FB + (uint64_t)target * A6_FB_STEP;
+	frame.dst_iova = fbdst;
 	uint32_t dim = sweet_backlight_alpha;
 	if (dim > 255) {
 		dim = 255;
@@ -735,7 +868,7 @@ sweet_gpu_present(int s, uintptr_t kva, uint32_t offset, uint32_t w, uint32_t h,
 			.src_iova = A6_GVA_POOL + DISPLAY_STAGE_OFF,
 			.src_w = PANEL_W, .src_h = PANEL_H, .src_pitch = fb_pitch,
 			.sx = frame.dx, .sy = frame.dy, .sw = frame.dw, .sh = frame.dh,
-			.dst_iova = A6_GVA_FB, .dst_pitch = fb_pitch,
+			.dst_iova = fbdst, .dst_pitch = fb_pitch,
 			.dx = frame.dx, .dy = frame.dy, .dw = frame.dw, .dh = frame.dh,
 		};
 		n += a6_blit_ib(&gpu, &copy_all, ib + n);
@@ -782,7 +915,7 @@ sweet_gpu_present(int s, uintptr_t kva, uint32_t offset, uint32_t w, uint32_t h,
 				.src_iova = A6_GVA_POOL + DISPLAY_STAGE_OFF,
 				.src_w = PANEL_W, .src_h = PANEL_H, .src_pitch = fb_pitch,
 				.sx = frame.dx, .sy = y, .sw = frame.dw, .sh = ext,
-				.dst_iova = A6_GVA_FB, .dst_pitch = fb_pitch,
+				.dst_iova = fbdst, .dst_pitch = fb_pitch,
 				.dx = frame.dx, .dy = y, .dw = frame.dw, .dh = ext,
 			};
 			n += a6_blit_ib(&gpu, &copy, ib + n);
@@ -803,6 +936,10 @@ sweet_gpu_present(int s, uintptr_t kva, uint32_t offset, uint32_t w, uint32_t h,
 		present_fence[k] = a6_submit_ib_async(&gpu, a6_pool_va(PRESENT_IB(k)), n, 100);
 		gpu_owner_locked(present_fence[k], 0);
 		rc = present_fence[k] ? 0 : -1;
+		if (rc == 0 && flip_state == 1) {
+			flip_pending = target;
+			flip_pending_fence = present_fence[k];
+		}
 		present_next++;
 	}
 	lck_mtx_unlock(&sweet_gpu_lock);
diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 389874a..eb2b28f 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -49,6 +49,8 @@ extern "C" {
 bool sweet_gpu_ready(void);
 int sweet_gpu_surface_slot(uint64_t key);
 int sweet_gpu_map_surface(uint64_t key, const uint64_t *pages, uint32_t npages, uint32_t page_size);
+void sweet_gpu_flip_poll(void);
+void sweet_gpu_flip_reset(void);
 int sweet_gpu_present(int slot, uintptr_t kva, uint32_t offset, uint32_t w, uint32_t h, uint32_t pitch,
 	uint32_t fb_pitch, uint32_t corner_radius, uint32_t *out_dx, uint32_t *out_dy,
 	uint32_t *out_dw, uint32_t *out_dh);
@@ -309,6 +311,7 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 		fb->fNextVsync = now + fb->fVsyncAbs;
 	}
 	sender->wakeAtTime(fb->fNextVsync);
+	sweet_gpu_flip_poll();          /* raphael: a finished frame goes on screen at the next TE */
 	if ((count % 300) == 0) {
 		/* Every 5 s: frames backboardd swapped, frames copied to the panel. */
 		IOLockLock(fb->fLock);
@@ -690,6 +693,9 @@ AppleCLCD::present(const uint8_t *rec)
 	} else if (!sweet_gpu_ready()) {
 		sweet_fb_last_fallback = "GPU not ready";
 	}
+	if (fLastPresentGPU) {
+		sweet_gpu_flip_reset();         /* the CPU draws into frame 0: put it back on screen */
+	}
 	fLastPresentGPU = false;
 	fCpuPresents++;
 	fLastLayerMask = mask;
-- 
2.43.0

